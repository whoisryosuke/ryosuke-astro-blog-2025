---
import { getCollection } from "astro:content";
import BlogTags from "../../../components/page/BlogPost/BlogTags/BlogTags";
import Container from "../../../components/primitives/Container/Container";
import type { SelectedBlogData } from "../../../data/selected-blogs";
import RootLayout from "../../../layouts/RootLayout.astro";
import BlogTagInteraction from "../../../components/page/BlogPost/BlogTags/BlogTagInteraction";
import Stack from "../../../components/primitives/Stack/Stack";


const posts = await getCollection('blog');
const uniqueTags = new Set<string>();
posts.forEach(post => post.data.tags.forEach(tag => uniqueTags.add(tag)))

const tags = [...uniqueTags].sort()

---

<RootLayout title="Blog Tag Cloud">
    <BlogTagInteraction title={"now what did I tag that blog"} tags={tags} height={900} client:load />
</RootLayout>
